<Window x:Class="P3k_Bluetooth_GamePad_Over_LAN.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="P3k Gamepad over LAN"
        Width="1020"
        Height="620"
        MinWidth="840"
        MinHeight="550"
        Background="#20232B"
        Foreground="#EDF1F7">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- CheckBox text does not inherit the window's light foreground; without this it renders black. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EDF1F7" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">
            <TextBlock Text="P3k Gamepad over LAN" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="Phone Bluetooth controller or touchscreen → Windows virtual gamepad"
                       Foreground="#AEBBD0"
                       Margin="0,5,0,15" />
            <TextBlock x:Name="ControllerState" Text="Starting…" FontSize="18" Foreground="#71DDB7" />
            <TextBlock x:Name="SourceInfo" Margin="0,5,0,12" />

            <WrapPanel Margin="0,0,0,12">
                <TextBlock Text="Gamepad output  " VerticalAlignment="Center" />
                <ComboBox x:Name="OutputMode"
                          Width="160"
                          SelectedIndex="0"
                          SelectionChanged="Settings_Changed"
                          Margin="0,0,16,0">
                    <ComboBoxItem Content="Xbox 360" />
                    <ComboBoxItem Content="DualShock 4" />
                </ComboBox>
            </WrapPanel>

            <Border Background="#2B303B" Padding="12" CornerRadius="5">
                <WrapPanel>
                    <ContentControl x:Name="JoystickElements" />
                    <ContentControl x:Name="DPadElements" />
                    <ContentControl x:Name="SecondaryButtonsElements" />
                    <ContentControl x:Name="PrimaryButtonsElements" />
                    <ContentControl x:Name="TriggerElements" />
                </WrapPanel>
            </Border>

            <TextBlock x:Name="Statistics" FontFamily="Consolas" Margin="0,14,0,8" />
            <TextBlock Text="Manual connection addresses (TCP 8080)" FontWeight="SemiBold" />
            <TextBox x:Name="Addresses"
                     IsReadOnly="True"
                     Background="#2B303B"
                     Foreground="White"
                     BorderThickness="0"
                     Padding="8"
                     Margin="0,6,0,12"
                     TextWrapping="Wrap" />

            <WrapPanel>
                <Button x:Name="StartButton" Content="Stop receiving" Click="Toggle_Click" />
                <Button x:Name="FirewallButton" Content="Add firewall exception" Click="Firewall_Click" />
                <Button Content="Save input log" Click="SaveLog_Click" />
                <Button Content="Reset counts" Click="Reset_Click" />
                <CheckBox x:Name="PublicNetwork"
                          Content="Also allow on Public networks"
                          VerticalAlignment="Center" />
            </WrapPanel>
            <TextBlock x:Name="FirewallStatus" Margin="0,10,0,0" Foreground="#AEBBD0" />
            <TextBlock Foreground="#AEBBD0" Margin="0,12,0,0">
                The phone shows measured round-trip timing. Input is released if the connection stalls for 500 ms.
                Keep the phone app in the foreground.
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</Window>
